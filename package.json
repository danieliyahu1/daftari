{
  "name": "daftari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch backend/server.ts",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "serve": "tsx backend/server.ts",
    "test:web": "npm --prefix frontend run test"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.9"
  }
}
